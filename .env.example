# EuroEdge environment. Copy to `.env` for local development (`cp .env.example .env`).
# 12-factor: every setting is an env var; services validate them at start-up and fail fast.
# Secrets are NEVER committed. Engine signer, relayer and deployer are three separate keys.

# ── Global ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# local | ci | staging | production — anything but local/ci is a deployed build.
DEPLOY_ENV=local
# sim | replay | live-min (brief §4.1). Public launch requires live-min.
DATA_TIER=sim
# Wallet-less dev login (M1). Refused unless DATA_TIER=sim and DEPLOY_ENV is local/ci.
DEV_LOGIN=false
LOG_LEVEL=info

# ── Infrastructure (docker compose) ─────────────────────────────────────────
POSTGRES_USER=euroedge
POSTGRES_PASSWORD=euroedge
POSTGRES_DB=euroedge
POSTGRES_PORT=5432
DATABASE_URL=postgres://euroedge:euroedge@localhost:5432/euroedge
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379
# Single origin for web + api + ws (ADR-0012).
CADDY_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# ── Service ports (host) ────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000
ENGINE_PORT=4010
# State snapshot every N events (M4-19); 0 disables.
ENGINE_SNAPSHOT_EVERY=10000
FV_SERVICE_PORT=4020
INGEST_PORT=4030
RELAYER_PORT=4040
INDEXER_PORT=4050
BOTS_PORT=4060
SIGNER_PORT=4070
# Simulated traders (M4-23/24), sim tier only: noise, momentum and mean-reversion bots.
BOTS_ENABLED=false
BOTS_COUNT=200
BOTS_INTERVAL_MS=2000
BOTS_SEED=7
BOTS_MARKETS=ASML-PERP
BOTS_FUND_USDC=10000

# ── Market data (M2+, live-min only; never called without a key) ────────────
REPLAY_PATH=data/sample
REPLAY_SPEED=1
SIM_SEED=42
PYTH_API_KEY=
TRADEGATE_VENDOR_URL=
TRADEGATE_VENDOR_KEY=

# ── Chain: Base Sepolia (M5+) ───────────────────────────────────────────────
CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=
# Separate keys (brief §12). Use a KMS/secret store outside local dev.
ENGINE_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
CDP_PAYMASTER_URL=
# Vault indexer (M5-09): off until the contracts are deployed; then the Vault and its deploy block.
INDEXER_ENABLED=false
VAULT_ADDRESS=
INDEXER_START_BLOCK=0
INDEXER_POLL_MS=4000
# Gasless relayer (M5-11): off until deployed; pays gas from RELAYER_PRIVATE_KEY.
RELAYER_ENABLED=false
TOKEN_ADDRESS=
RELAYER_MIN_ETH=0.05
# Engine signer (M5-08): signs withdrawals with ENGINE_SIGNER_PRIVATE_KEY (KMS outside local dev).
SIGNER_ENABLED=false

# ── Auth & API (M6+) ────────────────────────────────────────────────────────
SESSION_SECRET=
SIWE_DOMAIN=localhost:8080
# Privy app id (ADR-0020): email/Google/wallet sign-in. Empty = sign-in hidden, dev login only.
NEXT_PUBLIC_PRIVY_APP_ID=
ADMIN_WALLETS=

# ── Observability (M9) ──────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

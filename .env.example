# EuroEdge environment. Copy to `.env` for local development (`cp .env.example .env`).
# 12-factor: every setting is an env var; services validate them at start-up and fail fast.
# Secrets are NEVER committed. Engine signer, relayer and deployer are three separate keys.

# ── Global ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# local | ci | staging | production — anything but local/ci is a deployed build.
DEPLOY_ENV=local
# sim | replay | live-min (brief §4.1). Public launch requires live-min.
DATA_TIER=sim
# Wallet-less dev login (M1). Refused unless DATA_TIER=sim and DEPLOY_ENV is local/ci.
DEV_LOGIN=false
LOG_LEVEL=info

# ── Infrastructure (docker compose) ─────────────────────────────────────────
POSTGRES_USER=euroedge
POSTGRES_PASSWORD=euroedge
POSTGRES_DB=euroedge
POSTGRES_PORT=5432
DATABASE_URL=postgres://euroedge:euroedge@localhost:5432/euroedge
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379
# Single origin for web + api + ws (ADR-0012).
CADDY_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# ── Service ports (host) ────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000
ENGINE_PORT=4010
FV_SERVICE_PORT=4020
INGEST_PORT=4030
RELAYER_PORT=4040
INDEXER_PORT=4050
BOTS_PORT=4060

# ── Market data (M2+, live-min only; never called without a key) ────────────
REPLAY_PATH=data/sample
REPLAY_SPEED=1
SIM_SEED=42
PYTH_API_KEY=
TRADEGATE_VENDOR_URL=
TRADEGATE_VENDOR_KEY=

# ── Chain: Base Sepolia (M5+) ───────────────────────────────────────────────
CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=
# Separate keys (brief §12). Use a KMS/secret store outside local dev.
ENGINE_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
CDP_PAYMASTER_URL=

# ── Auth & API (M6+) ────────────────────────────────────────────────────────
SESSION_SECRET=
SIWE_DOMAIN=localhost:8080
ADMIN_WALLETS=

# ── Observability (M9) ──────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
